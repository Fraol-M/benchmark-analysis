#  LLM — choose one provider

# Option A: Gemini (recommended)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini/gemini-2.0-flash

# Option B: OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=openai/gpt-4o-mini

#  LangExtract Parser (only parser supported)
# LANGEXTRACT_API_KEY falls back to GEMINI_API_KEY when unset.
LANGEXTRACT_API_KEY=
LANGEXTRACT_MODEL_ID=gemini-2.5-flash
LANGEXTRACT_MODEL_URL=
LANGEXTRACT_EXAMPLES_PATH=data/langextract_examples.json
LANGEXTRACT_EXTRACTION_PASSES=1
LANGEXTRACT_MAX_WORKERS=1
LANGEXTRACT_SKIP_FUZZY=true
# Optional; defaults to CHUNK_SIZE when unset.
LANGEXTRACT_CHUNK_SIZE=2000
MENTION_PREPASS_ENABLED=true

#  Vector store 
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=pln_rag
OLLAMA_URL=http://localhost:11434/api/embeddings
OLLAMA_MODEL=nomic-embed-text

#  Atomspace 
ATOMSPACE_PATH=data/atomspace/kb.metta

# Predicate registry / mapping graph
PREDICATE_REGISTRY_ENABLED=true
PREDICATE_REGISTRY_PATH=data/predicate_registry.json
PREDICATE_MAPPING_ENABLED=true
PREDICATE_MAPPING_LLM_ENABLED=true
PREDICATE_MAPPING_COLLECTION=pln_rag_predicates
PREDICATE_MAPPING_TOP_K=6
PREDICATE_MAPPING_MAX_CANDIDATES=6
PREDICATE_MAPPING_MIN_SCORE=0.62
PREDICATE_MAPPING_PROOF_THRESHOLD=0.82
PREDICATE_MAPPING_TIMEOUT=12
PREDICATE_MAPPING_TOTAL_TIMEOUT=30

#  FAISS (no longer used)
FAISS_PATH=data/faiss

#  Processing 
CHUNK_SIZE=2000
CHUNK_OVERLAP=64
CONTEXT_TOP_K=10

#  Reasoning 
CHAINING_TIMEOUT=30
CHAINING_MAX_STEPS=100

#  Query execution 
QUERY_FALLBACK_ENABLED=true
