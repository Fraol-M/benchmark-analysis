# LangExtract API key for Gemini / other cloud-hosted LangExtract providers
LANGEXTRACT_API_KEY=your-langextract-api-key-here

# Default model used by this demo when you run --live without --ollama
LANGEXTRACT_MODEL_ID=gemini-2.5-flash

# Optional: OpenAI key if you switch to OpenAI-backed LangExtract models
# OPENAI_API_KEY=your-openai-api-key-here

# Optional: local Ollama base URL if you later use --live --ollama
# OLLAMA_BASE_URL=http://localhost:11434

# Optional: Dockerized PeTTaChainer reasoning service
PETTA_REASONER_URL=http://localhost:8010
